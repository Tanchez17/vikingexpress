<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="content-view" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se.lu.ics.vikingexpress.controller.VehicleController">
   <children>
      <VBox styleClass="content-header">
         <children>
            <Label styleClass="label-title" text="Fleet Management" />
         </children>
      </VBox>
      
      <HBox styleClass="content-body" spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="vehicleTable" onMouseClicked="#onSelectVehicle" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="vinColumn" prefWidth="75.0" text="VIN" />
                  <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Name" />
                  <TableColumn fx:id="typeColumn" prefWidth="75.0" text="Type" />
                  <TableColumn fx:id="capacityColumn" prefWidth="75.0" text="Capacity" />
                  <TableColumn fx:id="locationColumn" prefWidth="75.0" text="Location" />
                  <TableColumn fx:id="statusColumn" prefWidth="75.0" text="Status" />
                  <TableColumn fx:id="partsColumn" prefWidth="75.0" text="Parts replaced" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <VBox spacing="10.0" styleClass="form-panel" prefWidth="300.0">
               <children>
                  <Label styleClass="label-header" text="Vehicle Details" />
                  <TextField fx:id="vinField" editable="false" promptText="VIN" />
                  <TextField fx:id="nameField" promptText="Name" />
                  <javafx.scene.control.ComboBox fx:id="typeCombo" promptText="Type" />
                  <TextField fx:id="capacityField" promptText="Capacity" />
                  <TextField fx:id="locationField" promptText="Location" />
                  <TextField fx:id="costField" editable="false" promptText="Total Service Cost" />
                  <Label fx:id="costWarningLabel" styleClass="label-warning" text="" wrapText="true" />
               </children>
            </VBox>
         </children>
      </HBox>
      
      <HBox styleClass="content-actions" alignment="CENTER" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onAddVehicle" styleClass="button-primary" text="Add Vehicle" />
            <Button mnemonicParsing="false" onAction="#onEditVehicle" text="Edit Vehicle" />
            <Button mnemonicParsing="false" onAction="#onDeleteVehicle" styleClass="button-danger" text="Delete Vehicle" />
         </children>
      </HBox>
   </children>
</VBox>
