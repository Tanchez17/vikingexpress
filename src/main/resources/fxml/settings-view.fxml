<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="content-view" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se.lu.ics.vikingexpress.controller.SettingsController">
   <children>
      <VBox styleClass="content-header">
         <children>
            <Label styleClass="label-title" text="Settings" />
         </children>
      </VBox>
      
      <VBox styleClass="content-body" spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="15.0" styleClass="content-panel">
               <children>
                  <Label styleClass="label-header" text="Test Data" />
                  <VBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onLoadTestData" styleClass="button-primary" text="Load Test Data" />
                        <Button mnemonicParsing="false" onAction="#onResetData" styleClass="button-danger" text="Reset Application Data" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            
            <VBox spacing="15.0" styleClass="content-panel">
               <children>
                  <Label styleClass="label-header" text="Preferences" />
                  <VBox spacing="10.0">
                     <children>
                        <CheckBox mnemonicParsing="false" text="Show warnings for high service cost" />
                        <ToggleButton fx:id="darkModeToggle" mnemonicParsing="false" onAction="#onToggleDarkMode" text="Dark Mode" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            
            <VBox spacing="10.0" styleClass="content-panel">
               <children>
                  <Label styleClass="label-header" text="About" />
                  <Label styleClass="label-subtitle" text="Application version: 1.0-SNAPSHOT" />
                  <Label styleClass="label-subtitle" text="Developed by: Group 28 &quot;Lord of the Strings 2&quot;" />
                  <Label styleClass="label-subtitle" text="Java version: 21" />
                  <Label styleClass="label-subtitle" text="JavaFX version: 21.0.6" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>
