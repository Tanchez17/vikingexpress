<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="content-view" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se.lu.ics.vikingexpress.controller.ServiceHistoryController">
   <children>
      <VBox styleClass="content-header">
         <children>
            <Label styleClass="label-title" text="Service History" />
            <Label styleClass="label-subtitle" text="View completed service records. Click 'New Service Entry' to record a completed service." />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Filter by:" />
                  <RadioButton fx:id="byVehicleRadio" mnemonicParsing="false" text="Vehicle" />
                  <RadioButton fx:id="byWorkshopRadio" mnemonicParsing="false" text="Workshop" />
                  <Region HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="vehicleCombo" onAction="#onVehicleSelected" prefWidth="200.0" promptText="Select vehicle..." />
                  <ComboBox fx:id="workshopCombo" disable="true" managed="false" onAction="#onWorkshopSelected" prefWidth="200.0" promptText="Select workshop..." visible="false" />
                  <Button mnemonicParsing="false" onAction="#onNewServiceEntry" styleClass="button-primary" text="New Service Entry" />
               </children>
            </HBox>
         </children>
      </VBox>
      
      <HBox spacing="20.0" styleClass="content-body" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="historyTable" onMouseClicked="#onSelectEntry" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="dateColumn" prefWidth="75.0" text="Date" />
                  <TableColumn fx:id="vehicleColumn" prefWidth="75.0" text="Vehicle" />
                  <TableColumn fx:id="workshopColumn" prefWidth="75.0" text="Workshop" />
                  <TableColumn fx:id="descriptionColumn" maxWidth="1.7976931348623157E308" prefWidth="75.0" text="Problem Description" />
                  <TableColumn fx:id="costColumn" prefWidth="75.0" text="Cost" />
                  <TableColumn fx:id="partsColumn" prefWidth="75.0" text="Parts Replaced" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <VBox prefWidth="300.0" spacing="10.0" styleClass="form-panel">
               <children>
                  <VBox spacing="10.0" fx:id="workshopsSection">
                     <children>
                        <Label styleClass="label-header" text="Workshops Used" />
                        <ListView fx:id="workshopsListView" prefHeight="120.0" VBox.vgrow="NEVER" />
                     </children>
                  </VBox>
                  <Label styleClass="label-header" text="Service Details" />
                  <TextArea fx:id="descriptionArea" editable="false" promptText="Description" VBox.vgrow="SOMETIMES" />
                  <Label text="Parts Replaced:" />
                  <ListView fx:id="partsListView" prefHeight="150.0" VBox.vgrow="SOMETIMES" />
                  <Label text="Service Cost:" />
                  <TextField fx:id="costTextField" editable="false" styleClass="cost-display" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
