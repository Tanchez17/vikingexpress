<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se.lu.ics.vikingexpress.controller.MainController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="topbar" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="titleHeader" styleClass="app-title" text="VikingExpress Fleet Management" />
            <Region HBox.hgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
         </padding>
      </HBox>
   </top>
   <left>
    <VBox prefWidth="110.0" spacing="8.0" styleClass="sidebar" BorderPane.alignment="CENTER_LEFT">

        <children>

            <StackPane styleClass="sidebar-logo-wrap">
                <ImageView fitHeight="55.0" fitWidth="55.0" preserveRatio="true" styleClass="logo">
                    <image>
                        <Image url="@../images/VikingExpressLogo.png" />
                    </image>
                </ImageView>
            </StackPane>

            <Button fx:id="dashboardBtn" contentDisplay="TOP" graphicTextGap="6" maxWidth="1.7976931348623157E308" onAction="#onDashboard" styleClass="nav-button" text="Dashboard">
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                        <image>
                            <Image url="@../icons/dashboard_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="vehiclesBtn" contentDisplay="TOP" defaultButton="false" graphicTextGap="6" maxWidth="1.7976931348623157E308" onAction="#onVehicles" styleClass="nav-button" text="Vehicles">
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                        <image>
                            <Image url="@../icons/garage_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="workshopsBtn" contentDisplay="TOP" graphicTextGap="6" maxWidth="1.7976931348623157E308" onAction="#onWorkshops" styleClass="nav-button" text="Workshops">
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                        <image>
                            <Image url="@../icons/build_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="maintenanceBtn" contentDisplay="TOP" graphicTextGap="6" maxWidth="1.7976931348623157E308" onAction="#onMaintenance" styleClass="nav-button" text="Maintenance">
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                        <image>
                            <Image url="@../icons/handyman_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="serviceHistoryBtn" contentDisplay="TOP" graphicTextGap="6" maxWidth="1.7976931348623157E308" onAction="#onServiceHistory" styleClass="nav-button" text="Service History">
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                        <image>
                            <Image url="@../icons/history_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="reportsBtn" contentDisplay="TOP" graphicTextGap="6" maxWidth="1.7976931348623157E308" onAction="#onReports" styleClass="nav-button" text="Reports">
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                        <image>
                            <Image url="@../icons/report_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="settingsBtn" contentDisplay="TOP" defaultButton="false" graphicTextGap="6" maxWidth="1.7976931348623157E308" onAction="#onSettings" styleClass="nav-button" text="Settings">
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                        <image>
                            <Image url="@../icons/settings_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

        </children>

        <padding>
            <Insets bottom="16" left="12" right="12" top="18" />
        </padding>
    </VBox>
</left>
   <center>
      <StackPane fx:id="contentPane" styleClass="content-host" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
         </padding>
      </StackPane>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="statusbar" BorderPane.alignment="CENTER">
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelsFooter" text="VikingExpress Fleet Management © 2025 | Version 1.0" />
            <Region HBox.hgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
