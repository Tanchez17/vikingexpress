<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="content-view" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se.lu.ics.vikingexpress.controller.ReportsController">
   <children>
      <VBox styleClass="content-header">
         <children>
            <Label styleClass="label-title" text="Reports &amp; Statistics" />
         </children>
      </VBox>
      
      <VBox styleClass="content-body" spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="10.0" styleClass="content-panel">
               <children>
                  <Label fx:id="totalServiceCostLabel" styleClass="label-header" text="Total service cost: 0.00" />
                  <Label fx:id="averageCostLabel" styleClass="label-header" text="Average maintenance cost: 0.00" />
                  <Label fx:id="mostExpensiveJobsLabel" styleClass="label-header" text="Most expensive job: N/A" />
                  <Label fx:id="mostExpensiveWorkshopsLabel" styleClass="label-header" text="Most expensive workshop: N/A" />
                  <Label fx:id="mostExpensiveVehiclesLabel" styleClass="label-header" text="Most expensive vehicle: N/A" />
               </children>
            </VBox>
            
            <VBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="workshopCostTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="workshopNameColumn" prefWidth="75.0" text="Workshop" />
                        <TableColumn fx:id="workshopCostColumn" prefWidth="75.0" text="Total Cost" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  
                  <TableView fx:id="vehicleCostTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="vehicleNameColumn" prefWidth="75.0" text="Vehicle" />
                        <TableColumn fx:id="vehicleCostColumn" prefWidth="75.0" text="Total Cost" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
      
      <HBox styleClass="content-actions" alignment="CENTER" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onRefresh" text="Refresh" />
            <Button mnemonicParsing="false" onAction="#onExport" styleClass="button-primary" text="Export Report" />
         </children>
      </HBox>
   </children>
</VBox>
